# Copy this file to .env.local and change the values.

# ---------- Database (required) ----------
# Neon > your project > Connect. Use the POOLED string (host has "-pooler") here.
DATABASE_URL=
# Optional: the direct (not pooled) string, used only by "npm run db:setup" to create tables.
DATABASE_URL_UNPOOLED=
# Database connections per server instance (default 10).
DB_POOL_MAX=10
# OTP requests allowed per IP per hour (a school can share one IP). Default 300.
OTP_IP_LIMIT=300
# Secret for the background job URL /api/cron/reminders (call it every 5 minutes).
CRON_SECRET=

# Long random string. Used to sign login cookies. CHANGE THIS before going live.
AUTH_SECRET=change-me-to-a-long-random-string

# Password for /admin. CHANGE THIS before going live.
ADMIN_PASSWORD=admin123

# How many students can book the same call slot (number of counsellors free per slot).
COUNSELLOR_CAPACITY=2

# Public URL of the site (used inside SMS and calendar events)
SITE_URL=http://localhost:3000
# Google Search Console > Add property > HTML tag: paste only the content="..." code here
GOOGLE_SITE_VERIFICATION=

# ---------- WhatsApp (Meta WhatsApp Cloud API) ----------
# From developers.facebook.com > your app > WhatsApp > API Setup. Steps in README.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Optional: template names if you named them differently (defaults: proxam_booked, proxam_link, proxam_reminder, proxam_cancelled, proxam_otp)
WHATSAPP_TEMPLATE_LANG=en

# ---------- Login OTP by email ----------
# On the live site the OTP is never shown on screen: without an email service, login is closed.
# For a local `npm start` test only, ALLOW_DEV_OTP=1 shows it again (never set this in the hosting settings).
# Leave all three keys empty while developing: the OTP shows on screen (dev mode).
# Providers are tried in this order; only those with a key are used. Steps in README.
EMAIL_PROVIDERS=zeptomail,brevo,resend
MAIL_FROM=otp@proxam.in
MAIL_FROM_NAME=Proxam
# ZeptoMail: Mail Agents > SMTP/API. Copy the "Send Mail Token" and the API URL shown there.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
# Later, when the free ZeptoMail credit runs out: free fallbacks (no code change needed)
BREVO_API_KEY=
RESEND_API_KEY=

# ---------- SMS (MSG91): call reminders only ----------
# Leave SMS_PROVIDER empty while developing: SMS are only logged (Admin > Messages).
SMS_PROVIDER=
MSG91_AUTH_KEY=
# DLT-approved MSG91 Flow template ids (template texts are in README)
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_BOOKED=
MSG91_TEMPLATE_LINK=
MSG91_TEMPLATE_REMINDER=
MSG91_TEMPLATE_CANCELLED=

# ---------- Google Calendar + Meet: "Connect Google Calendar" button (works with normal Gmail) ----------
# OAuth client from Google Cloud Console (steps in README). Then Admin > Calendar > Connect Google Calendar.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- OR: Google Workspace service account (only if you use Workspace) ----------
# Team calendar id (Google Calendar > Settings > your calendar > Integrate calendar > Calendar ID)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON, keep the \n characters, in double quotes
GOOGLE_PRIVATE_KEY=
# Google Workspace user the service account acts as (needed to create Meet links)
GOOGLE_IMPERSONATE_USER=

# ---------- Zoom (Server-to-Server OAuth app) ----------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional: which Zoom user hosts the meetings (default: the app owner)
ZOOM_HOST_EMAIL=

# Only needed on hosting where the server sleeps: secret for /api/cron/reminders
CRON_SECRET=

# Razorpay: batches, extra tests (₹49) and masterclasses.
# Razorpay dashboard > Account & Settings > API Keys. Test keys start with rzp_test_, live keys with rzp_live_.
# Empty on your laptop = demo mode (enrols without charging). Empty on the live site = buying is closed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Webhooks > Add: URL https://proxam.in/api/pay/webhook,
# events payment.captured + order.paid, and type any long random secret here and there.
RAZORPAY_WEBHOOK_SECRET=
